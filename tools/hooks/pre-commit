#!/bin/sh
# HBC+ pre-commit check (v1.3): versions, flow files, versions.json, and the EN/NL guides.
# Install once per clone or worktree:   git config core.hooksPath tools/hooks
# Skip it for one commit (work in progress):   git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
out=$(python3 tools/check-versions.py 2>&1) || { echo "$out"; echo; echo "pre-commit: fix the versions above (tools/set-version.py), or commit with --no-verify"; exit 1; }
python3 tools/check-docs.py || { echo; echo "pre-commit: bring both guides in step, or commit with --no-verify"; exit 1; }
